# Trading
TRADING_MODE=paper                    # paper | live | halted
INITIAL_BALANCE=10000                 # Paper trading starting balance (USDC)

# Polymarket
POLYMARKET_API_KEY=                   # For live trading (leave empty for paper)
POLYMARKET_WALLET_PRIVATE_KEY=        # For live trading (leave empty for paper)

# Risk Management
MAX_POSITION_PCT=0.05                 # 5% max per position
MAX_EXPOSURE_PCT=0.40                 # 40% max total
DAILY_LOSS_LIMIT_PCT=0.05            # 5% daily loss → halt
MIN_EV_THRESHOLD=0.02                # 2% minimum expected value

# Scanner
SCAN_INTERVAL_SECONDS=30
MIN_LIQUIDITY=5000
MIN_VOLUME_24H=1000
MAX_SPREAD=0.05

# Server
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./warroom.db
